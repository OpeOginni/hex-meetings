---
// The animated story at the top of the landing page.
// Add ?t=12 to the URL to see one moment, ?debug to render the soundtrack.
import icon from "../assets/icon.svg";
import slack from "../assets/marks/slack.svg";
import notion from "../assets/marks/notion.svg";
import opencode from "../assets/marks/opencode.svg";
import github from "../assets/marks/github.svg";
import linear from "../assets/marks/linear.svg";
import claude from "../assets/marks/claude.svg";
import codex from "../assets/marks/codex.svg";
import cursor from "../assets/marks/cursor.svg";
import pi from "../assets/marks/pi.svg";

const marks = {
  icon: icon.src,
  slack: slack.src,
  notion: notion.src,
  github: github.src,
  linear: linear.src,
  opencode: opencode.src,
  claude: claude.src,
  codex: codex.src,
  cursor: cursor.src,
  pi: pi.src,
};
---

  <div class="intro" data-intro>
    <img class="intro__icon" src={icon.src} width="112" height="112" alt="" />
    <button type="button" class="play" data-play aria-label="Play the story with sound">
      <span class="play__pill">
        <span class="play__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg></span>
        See how it works
      </span>
      <span class="play__hint">Best with sound on</span>
    </button>
  </div>
  <div class="frame" data-frame>
    <div class="show" data-show data-marks={JSON.stringify(marks)}></div>
  </div>
  <div class="controls" data-controls>
    <button type="button" data-mute aria-pressed="false"></button>
    <button type="button" data-replay hidden>Replay</button>
  </div>

<script>
  import { mountShow, renderSoundtrack } from "../show";
  void mountShow();
  // ?debug exposes the soundtrack render, for checking the mix.
  if (location.search.includes("debug")) Object.assign(window, { renderSoundtrack });
</script>

<style is:global>

  /* Before play: the icon with the play button under it, like the home page's icon. */
  .intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    max-height: 320px;
    transition:
      opacity 0.35s,
      max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .intro[data-gone] {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }
  .intro__icon {
    width: 112px;
    height: 112px;
    filter: drop-shadow(0 18px 40px #2f56d066);
  }

  /* The stage takes no room until the story plays, then opens to its full height. */
  .frame {
    position: relative;
    width: min(1280px, 100%, calc((100svh - 150px) * 2));
    height: 0;
    margin: 0 auto;
    text-align: left;
    transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .frame[data-open] {
    height: var(--h);
  }

  /* The play button, under the icon, before the show starts. */
  .play {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
    transition: opacity 0.3s;
  }


  .play__pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 24px 8px 8px;
    border-radius: 999px;
    background: #ffffff0d;
    box-shadow:
      inset 0 0 0 1px #8fb0ff40,
      0 12px 40px #2f56d033;
    font-weight: 600;
    font-size: 1.0625rem;
    transition:
      background 0.15s,
      scale 0.15s;
  }

  .play:hover .play__pill {
    background: #ffffff17;
  }

  .play:active .play__pill {
    scale: 0.97;
  }

  .play__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--seal);
    box-shadow: inset 0 1px 0 #ffffff40;
  }

  .play__icon svg {
    width: 18px;
    fill: #fff;
    translate: 1px 0;
  }

  .play__hint {
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Under the stage, once the story plays. */
  .controls {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 10px;
  }
  .controls:not([data-on]) {
    display: none;
  }

  .controls button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 0;
    border-radius: 8px;
    background: #ffffff12;
    color: #cfcfd4;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 560;
    cursor: pointer;
  }

  .controls button[hidden] {
    display: none;
  }
  .controls button:hover {
    background: #ffffff1c;
    color: var(--fg);
  }


  /* The stage: 1280 by 640 units, scaled to the frame. Everything inside is placed by show.ts. */
  .show {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 640px;
    transform-origin: 0 0;
    scale: var(--s, 1);
    font-size: 15px;
    line-height: 1.4;
  }

  .show > * {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform, opacity;
  }

  .show .card {
    width: 300px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 18px 50px #000b;
  }

  .show .card__head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  .show .card__head img,
  .show .card__head svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .show .card__head b {
    color: var(--fg);
    font-weight: 600;
  }

  .show .card__title {
    margin-top: 6px;
    font-weight: 600;
  }

  .show .card__body {
    margin-top: 2px;
    color: #cfcfd4;
  }

  .show .badge {
    position: absolute;
    top: -8px;
    left: -8px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: #e5484d;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 22px;
    text-align: center;
  }

  .show .call {
    width: 420px;
    padding: 16px 18px;
  }

  .show .call h3,
  .show .panel h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 620;
  }

  .show .meta {
    margin-top: 2px;
    font-size: 13px;
    color: var(--muted);
  }

  .show .line {
    margin-top: 10px;
  }

  /* You and Them, told apart the way the app does: You in blue, Them in the call's green. */
  .show .line {
    display: flex;
    gap: 10px;
  }
  .show .who {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    width: 58px;
    font-weight: 600;
  }
  .show .who i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3dd68c;
  }
  .show .line--you .who {
    color: var(--accent);
  }
  .show .line--you .who i {
    background: var(--accent);
  }

  .show .chat {
    width: 360px;
  }

  .show .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border-radius: 6px;
    background: #ffffff10;
    font-size: 12px;
    color: #cfcfd4;
  }

  .show .chip img {
    width: 14px;
    height: 14px;
  }

  .show .input {
    min-height: 72px;
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: #141414;
    border: 1px solid var(--line);
  }

  .show .file {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 4px 10px;
    border-radius: 8px;
    background: #ffffff10;
    font-size: 13px;
  }

  .show .upload {
    height: 4px;
    margin-top: 12px;
    border-radius: 2px;
    background: #ffffff12;
    overflow: hidden;
  }

  .show .upload i {
    display: block;
    height: 100%;
    background: #e5484d;
  }

  .show .warn {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #ff8589;
  }

  .show .flier {
    padding: 4px 10px;
    border-radius: 8px;
    background: #2a2a2e;
    border: 1px solid var(--line);
    font-size: 13px;
    white-space: nowrap;
  }

  .show .caption {
    width: 1280px;
    text-align: center;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }








  .show .vignette {
    width: 1280px;
    height: 640px;
    background: radial-gradient(ellipse closest-side at 50% 50%, #e5484d4d 0%, #e5484d1a 55%, transparent 100%);
    pointer-events: none;
  }

  .show .flash {
    width: 760px;
    height: 760px;
    background: radial-gradient(circle closest-side, #ffffff 0%, #8fb0ff 30%, #2f56d066 60%, #2f56d000 100%);
    pointer-events: none;
  }

  .show .rings {
    width: 1280px;
    height: 640px;
    overflow: visible;
    pointer-events: none;
  }

  .show .rings path {
    fill: none;
    stroke: var(--accent);
  }

  .show .mark {
    width: 140px;
    height: 140px;
    filter: drop-shadow(0 20px 50px #2f56d099);
  }

  .show .panel {
    width: 460px;
    padding: 16px 18px;
  }

  .show .panel__row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }

  .show .panel .chip {
    padding: 5px 10px;
    font-size: 13px;
  }

  .show .note {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  .show .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 5px 14px;
    border-radius: 8px;
    background: #ededed;
    color: #121212;
    font-size: 13px;
    font-weight: 620;
  }

  .show .btn--quiet {
    margin-left: 0;
    background: #ffffff12;
    color: var(--fg);
  }

  .show .result {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .show .result p {
    margin: 0;
  }

  .show .result h4 {
    margin: 12px 0 4px;
    font-size: 15px;
    font-weight: 620;
  }

  .show .item {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    padding: 3px 8px;
    border-radius: 8px;
  }

  .show .tick {
    position: relative;
    width: 18px;
    height: 18px;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid #ffffff40;
  }

  .show .wipe {
    position: relative;
  }

  .show .wipe::after {
    content: "";
    position: absolute;
    inset: -2px -4px;
    background: var(--surface);
    clip-path: inset(0 0 0 calc(var(--w, 0) * 100%));
  }

  .show .ready {
    padding: 1px 8px;
    border-radius: 6px;
    background: #2f56d033;
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
  }

  .show .posted {
    background: #30a46c33;
    color: #4cc38a;
  }

  .show .bullets {
    margin: 8px 0 0;
    padding-left: 20px;
  }

  .show .chip .chev {
    flex: none;
    opacity: 0.7;
  }

  .show .call h3 {
    margin-top: 10px;
  }

  .show .hexsum {
    margin-top: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #ffffff0a;
    font-size: 14px;
    color: #cfcfd4;
  }

  .show .hexsum span {
    display: block;
    font-size: 12px;
    color: var(--muted);
  }

  .show .skel {
    margin-top: 12px;
  }

  .show .skel i {
    display: block;
    height: 9px;
    margin-top: 7px;
    border-radius: 5px;
    background: #ffffff1c;
  }

  .show .composer {
    min-height: 44px;
    margin-top: 8px;
    font-size: 14px;
    color: #cfcfd4;
  }

  .show .input.composer {
    min-height: 52px;
    padding: 8px 10px;
  }

  .show .muted {
    color: var(--muted);
  }

  .show .list {
    width: 300px;
    padding: 14px;
  }

  .show .list .card__head {
    margin-bottom: 8px;
    font-size: 15px;
  }

  .show .row {
    display: flex;
    flex-direction: column;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 14px;
  }

  .show .row b {
    font-weight: 600;
  }

  .show .row span {
    font-size: 12px;
    color: var(--muted);
  }

  .show .row--on {
    background: #ffffff12;
  }

  .show .label {
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted);
  }

  .show .panel .label + .panel__row {
    margin-top: 6px;
  }

  .show .wrap {
    flex-wrap: wrap;
  }

  .show .agent {
    gap: 8px;
  }

  .show .agent__face {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .show .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100px;
    padding: 14px 8px;
    font-size: 14px;
    font-weight: 560;
  }

  .show .pulse {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 16px 6px var(--accent);
  }
  /* Too small to read on a phone: the hero shows the icon instead. */
  @media (max-width: 720px) {
    .intro,
    .frame,
    .controls {
      display: none;
    }
  }

</style>
